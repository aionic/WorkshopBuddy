# --- AI provider configuration ---
# AI_PROVIDER can be "azure_foundry" (Entra-only, Responses API),
# "azure_openai" (key-based chat completions), "openai", or unset for demo mode.
AI_PROVIDER=azure_foundry

# Azure AI Foundry (Entra ID auth - no API keys). Uses DefaultAzureCredential.
# Endpoint is the FULL responses URL of your model deployment.
AZURE_FOUNDRY_RESPONSES_ENDPOINT=https://jamesbas-demo-project-resource.services.ai.azure.com/api/projects/jamesbas-demo-project/openai/v1/responses
AZURE_FOUNDRY_MODEL=gpt-5.4
# Optional fallback Azure OpenAI v1 endpoint (also Entra-auth) for chat completions:
AZURE_OPENAI_V1_ENDPOINT=https://jamesbas-project-no-hub-resource.openai.azure.com/openai/v1

# Azure OpenAI (key-based, legacy)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
# SQLite default. Override for Azure SQL: sqlserver://...
DATABASE_URL="file:./data/innovateimpact.db"

# --- App ---
APP_NAME="Workshop Buddy"
DEMO_MODE=true
