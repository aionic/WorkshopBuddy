// Workshop Buddy - Prisma schema
generator client {
  provider      = "prisma-client-js"
  // Driver adapters (`@prisma/adapter-pg`) require the default "library"
  // (N-API) query engine — `engineType = "binary"` is incompatible and
  // throws `PrismaClientConstructorValidationError` at runtime.
  // `debian-openssl-3.0.x` matches the runtime image (node:20-bookworm-slim).
  // `native` covers local dev on Windows / macOS.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // Note: `driverAdapters` graduated to stable in Prisma 6 and no longer
  // needs to be listed under previewFeatures. We use @prisma/adapter-pg
  // to authenticate against Azure Database for PostgreSQL Flexible Server
  // using a Microsoft Entra access token (refreshed per pool connection
  // via @azure/identity).
}

datasource db {
  // Azure Database for PostgreSQL Flexible Server with Entra-only auth.
  // DATABASE_URL example:
  //   postgresql://workshopbuddy-uami@pg-workshopbuddy-eus.postgres.database.azure.com:5432/workshopbuddy?sslmode=require
  // The runtime password is an Entra access token fetched at startup
  // (and on every new pool connection) via @azure/identity.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                String          @id @default(cuid())
  name              String
  /// Entra object id (`oid`) of the user who owns this project. Populated from
  /// the ACA Easy Auth `X-MS-CLIENT-PRINCIPAL-ID` header on create. Required
  /// for AuthZ: only the owner can read/write a project (P0-1).
  ownerId           String
  clientName        String?
  /// Microsoft TPID (Top Parent ID) for the customer account. Optional.
  tpid              String?
  /// MSX (Microsoft Sales Experience) opportunity ID. Optional.
  msxOppId          String?
  industry          String?
  businessProblem   String
  desiredOutcomes   String          @default("[]")
  targetAudience    String          @default("[]")
  selectedArtifacts String          @default("[]")
  timeHorizon       String?
  status            String          @default("Draft")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  inputs            WorkshopInput[]
  agentRuns         AgentRun[]
  artifacts         Artifact[]
  transcriptIngests TranscriptIngest[]

  // S-2: hot read pattern is `findMany(where ownerId, orderBy updatedAt desc)`.
  @@index([ownerId, updatedAt(sort: Desc)])
}

model WorkshopInput {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category           String
  persona            String?
  priority           String            @default("Medium")
  content            String
  submittedBy        String?
  votes              Int               @default(0)
  createdAt          DateTime          @default(now())
  /// Optional link back to the transcript ingestion that produced this row,
  /// for traceability and future "revert / re-extract" flows.
  transcriptIngestId String?
  transcriptIngest   TranscriptIngest? @relation(fields: [transcriptIngestId], references: [id], onDelete: SetNull)

  // S-2: hot read patterns — list per project ordered by createdAt, and FK lookup.
  @@index([projectId, createdAt(sort: Desc)])
  @@index([transcriptIngestId])
}

/// Audit row written every time a transcript is ingested for a project.
/// Captures source metadata (no transcript content) plus how many cards were
/// produced. Each WorkshopInput written from this ingest carries the FK back.
model TranscriptIngest {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source        String          // "paste" | "upload"
  filename      String?
  format        String?         // txt | md | vtt | srt | docx | pdf
  charLength    Int             @default(0)
  cardsProposed Int             @default(0)
  cardsAccepted Int             @default(0)
  usedLLM       Boolean         @default(false)
  llmError      String?
  hints         String?
  createdAt     DateTime        @default(now())
  inputs        WorkshopInput[]

  // S-2: FK lookup pattern.
  @@index([projectId])
}

model AgentRun {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      String    @default("Queued")
  inputJson   String
  outputJson  String?
  logJson     String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  // S-2: hot reads — list per project ordered by createdAt; sweeper scans by status.
  @@index([projectId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model Artifact {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifactType   String
  title          String
  status         String            @default("Draft")
  currentVersion Int               @default(1)
  contentJson    String
  markdown       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  versions       ArtifactVersion[]

  // S-1: one artifact per (project, type) — the worker + web fallback both
  // "upsert by type". Without this constraint racing runs could create duplicate
  // rows that the UI then surfaces as confusing twins.
  @@unique([projectId, artifactType])
  // S-2: hot read — list per project ordered by updatedAt.
  @@index([projectId, updatedAt(sort: Desc)])
}

model ArtifactVersion {
  id          String   @id @default(cuid())
  artifactId  String
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  version     Int
  contentJson String
  markdown    String?
  notes       String?
  createdAt   DateTime @default(now())

  // S-2: hot read — versions(orderBy version desc) for the workspace history view.
  @@index([artifactId, version(sort: Desc)])
}
